    <string name="stage_4_name">Abschnitt 4: Lagune</string>
    <string name="stage_4_description">Ein Flug von der Nacht in den Mittag über eine Bucht voller Inseln, und Haie kommen von hinten. Die Naga steigt aus dem Graben des Tempels.</string>
