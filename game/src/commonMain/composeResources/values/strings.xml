    <string name="stage_select_title">Select Stage</string>
    <!-- Each also heads its own run, on the frame, as the run opens and on the stage complete screen. -->
    <string name="stage_1_name">Stage 1: The Jungle</string>
    <string name="stage_1_description">Swarms, formations, shields and return fire among overgrown ruins. The Moth Queen waits at the end.</string>
    <string name="stage_2_name">Stage 2: The Cave</string>
    <string name="stage_2_description">Five waves of imps in the dark, and the imp that leads them - which can put its own light out.</string>
    <string name="stage_3_name">Stage 3: The Desert</string>
    <string name="stage_3_description">Flown from noon into nightfall, with things leaping out of the sand. The Sand Wyrm rises after dark.</string>
    <string name="stage_4_name">Stage 4: The Lagoon</string>
    <string name="stage_4_description">Flown from night into noon across a bay of islands, with sharks coming from behind. The Naga rises from the temple's moat.</string>
    <string name="stage_locked">Clear the stage before it to unlock</string>
