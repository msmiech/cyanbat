<?xml version="1.0" encoding="utf-8"?>
<!--
    The launcher icon. Adaptive, so each launcher cuts it to its own shape and can slide the bat
    across the moon; minSdk 26 is the release that introduced them, so no bitmap fallback is
    needed. The three layers are generated by tools/generate_icons.py.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
