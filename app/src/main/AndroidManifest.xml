<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name">
        <!-- uiMode: the menu follows the system into dark or light by recomposing in place. Being
             recreated instead put the player back on the main screen and the menu track back to
             its start. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:exported="true"
            android:screenOrientation="landscape"
            tools:ignore="DiscouragedApi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".activity.CyanBatGameActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:label="@string/in_game"
            android:screenOrientation="landscape"
            tools:ignore="DiscouragedApi" />

    </application>

</manifest>